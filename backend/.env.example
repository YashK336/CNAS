# Copy to `.env` and set your AuraDB credentials locally.
# Never commit `.env`.

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# PostgreSQL persistence for saved investigations
DATABASE_URL=postgresql://cnas:cnas@localhost:5432/cnas
# Optional discrete settings used when DATABASE_URL is unset:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cnas
# POSTGRES_USER=cnas
# POSTGRES_PASSWORD=cnas

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Local dev fallback when PostgreSQL is not installed yet.
# Set to 1 for in-memory auth/investigations/audit/import history; 0 or unset for PostgreSQL.
# CNAS_USE_MEMORY_STORE=0

# Aura Graph Analytics session settings for PageRank/Louvain projections
# GDS_SESSION_NAME=cnas-analytics
# GDS_SESSION_MEMORY=2GB
# GDS_SESSION_TTL_MINUTES=30
